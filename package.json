{
  "name": "aurora-access-browser",
  "private": true,
  "version": "2.0.6",
  "author": {
    "name": "Aladdin Aliyev",
    "email": "213189260+aliyevaladddin@users.noreply.github.com"
  },
  "description": "Aurora Access: Silicon-Validated Sentinel Gateway (RCF-PL 2.1.8, open source)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuroraAccess/aurora-access-browser.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "prepare": "husky",
    "start": "npm run electron:dev",
    "dev": "vite",
    "clean": "node -e \"for (const d of ['dist','release']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "npm run clean && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dev:headless": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && xvfb-run -a electron .\"",
    "electron:build": "npm run clean && vite build && electron-builder",
    "electron:deploy": "npm run electron:build -- --publish always",
    "rcf": "node bin/rcf-cli.js",
    "lint": "eslint src electron",
    "verify:proxy": "node bin/verify-proxy.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@tskau/vtrans": "^1.0.1",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "electron": "^44.6.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "vite": "^5.4.10",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.aurora.browser",
    "productName": "Aurora Access Browser",
    "copyright": "Copyright © 2026 Aurora Access",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AuroraAccess",
        "repo": "aurora-access-browser",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/${version}"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@39.8.10": true,
    "protobufjs@7.6.6": true
  }
}
